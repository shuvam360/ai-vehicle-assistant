# Flask Application Settings
FLASK_DEBUG=false

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# API Authentication (Header: X-API-Key)
# If set, all /api routes require this key (except /health)
API_KEY=your-secure-api-key-here

# Real Navigation Geocoding & Routing (Optional)
# If not set, system seamlessly falls back to dynamic mock routing with "mock": true
OPENROUTESERVICE_API_KEY=

# SQLite Database Path for Audit History
SQLITE_DB_PATH=audit_history.db
